@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5">
    <h1>Admin Dashboard</h1>

    <p>Welcome to Admin Dashboard.</p>

    <div class="row mt-4">

        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h4>Users</h4>
                <p>View and manage user data.</p>
                <a asp-controller="Admin"
                   asp-action="Users"
                   class="btn btn-primary">
                    Manage Users
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h4>Categories</h4>
                <p>View and manage categories.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h4>Expenses</h4>
                <p>View and manage expenses.</p>
            </div>
        </div>

    </div>
</div>