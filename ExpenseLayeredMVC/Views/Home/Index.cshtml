@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h3 class="fw-bold m-0">Expense Tracker Dashboard</h3>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-success shadow-sm">
            <div class="card-body text-center">
                <h6 class="card-title fw-bold text-dark">Total Income</h6>
                <h3 class="fw-bold mb-0 text-success">@ViewBag.TotalIncome?.ToString("C")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-danger shadow-sm">
            <div class="card-body text-center">
                <h6 class="card-title fw-bold text-dark">Total Expense</h6>
                <h3 class="fw-bold mb-0 text-danger">@ViewBag.TotalExpense?.ToString("C")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-primary shadow-sm">
            <div class="card-body text-center">
                <h6 class="card-title fw-bold text-dark">Current Balance</h6>
                <h3 class="fw-bold mb-0 text-primary">@ViewBag.RemainingBalance?.ToString("C")</h3>
            </div>
        </div>
    </div>
</div>

<div class="mb-4 d-flex gap-2">
    <a asp-controller="Income" asp-action="Create" class="btn btn-success text-white px-3"><small>+ Add Income</small></a>
    <a asp-controller="Expense" asp-action="Create" class="btn btn-danger text-white px-3"><small>+ Add Expense</small></a>
    <a asp-controller="Category" asp-action="Create" class="btn btn-primary text-white px-3"><small>+ Add Category</small></a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-dark text-white border-0 py-2">
        <h6 class="mb-0 fw-bold">Recent Transaction History</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3 border-0">Date</th>
                        <th class="border-0">Type</th>
                        <th class="border-0">Title</th>
                        <th class="pe-3 border-0">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var recentExpenses = ViewBag.RecentExpenses as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
                        var recentIncomes = ViewBag.RecentIncomes as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
                        
                        var transactions = recentExpenses.Select(e => new { 
                            Date = e.ExpenseDate ?? DateTime.Now, 
                            Type = "Expense", 
                            Title = e.Title, 
                            Amount = e.Amount 
                        })
                        .Concat(recentIncomes.Select(i => new { 
                            Date = i.IncomeDate, 
                            Type = "Income", 
                            Title = i.Title, 
                            Amount = i.Amount 
                        }))
                        .OrderByDescending(t => t.Date)
                        .Take(5)
                        .ToList();
                    }

                    @if (transactions.Any())
                    {
                        @foreach (var t in transactions)
                        {
                            <tr>
                                <td class="ps-3">@t.Date.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (t.Type == "Expense")
                                    {
                                        <span class="badge bg-danger rounded-pill px-3">Expense</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success rounded-pill px-3">Income</span>
                                    }
                                </td>
                                <td>@t.Title</td>
                                <td class="pe-3">@t.Amount.ToString("C")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No recent transactions.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
