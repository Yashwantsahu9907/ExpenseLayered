@model IEnumerable<ExpenseLayeredMVC.Models.ExpenseDto>
@{
    ViewData["Title"] = "Expenses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0">Expenses</h3>
    <a asp-action="Create" class="btn btn-danger text-white px-3"><small>+ Add Expense</small></a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark text-white">
                    <tr>
                        <th class="ps-3 border-0">Title</th>
                        <th class="border-0">Amount</th>
                        <th class="border-0">Category</th>
                        <th class="border-0">Description</th>
                        <th class="border-0">Date</th>
                        <th class="border-0">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">@item.Title</td>
                                <td>@item.Amount.ToString("C")</td>
                                <td>@(item.CategoryName ?? "Category " + item.CategoryId)</td>
                                <td>@item.Description</td>
                                <td>@(item.ExpenseDate == default ? DateTime.Now.ToString("yyyy-MM-dd") : item.ExpenseDate.ToString("yyyy-MM-dd"))</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm text-white px-2">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm text-white px-2" onclick="return confirm('Are you sure you want to delete this expense?');">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No expenses found. Click "Add Expense" to record one.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
