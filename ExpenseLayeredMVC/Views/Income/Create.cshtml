@model ExpenseLayeredMVC.Models.IncomeDto
@{
    ViewData["Title"] = "Add Income";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0">Add Income</h3>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form asp-action="Create">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-medium">Title</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Salary" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label fw-medium">Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Amount" type="number"  class="form-control" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="IncomeDate" class="form-label fw-medium">Date</label>
                        <input asp-for="IncomeDate" type="date" class="form-control" />
                        <span asp-validation-for="IncomeDate" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-success w-100 fw-bold"><i class="bi bi-check-lg me-1"></i> Save Income</button>
                </form>
            </div>
        </div>
    </div>
</div>
